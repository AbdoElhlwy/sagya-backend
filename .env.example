# ══════════════════════════════════════════════════
# سقيا الحرمين - Backend Environment Variables
# نسعى لسقيا ضيوف الرحمن
# ══════════════════════════════════════════════════

# === عام ===
NODE_ENV=production
PORT=5000

# === قاعدة البيانات ===
DB_PATH=./database/sagya.db
UPLOADS_PATH=./uploads

# === الأمان - غيّر هذه القيم حتماً! ===
JWT_SECRET=sagya_haramain_CHANGE_THIS_TO_RANDOM_LONG_STRING_IN_PROD_2024
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# === CORS ===
# اتركه فارغاً للسماح بالكل، أو ضع النطاقات مفصولة بفاصلة
CORS_ORIGINS=*

# === رابط التطبيق ===
APP_URL=https://sagya-backend.onrender.com
ADMIN_URL=https://your-admin-domain.vercel.app

# ══════════════════════════════════════════════════
# SMS Provider - مزود الرسائل القصيرة
# Options: mock | twilio | unifonic | msegat | taqnyat
# ══════════════════════════════════════════════════
SMS_PROVIDER=mock

# Twilio
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# Unifonic / Msegat / Taqnyat (same API format)
SMS_API_KEY=your_sms_api_key
SMS_APP_SID=your_app_sid
SMS_SENDER_ID=SaqyaH

# ══════════════════════════════════════════════════
# Payment Gateways - بوابات الدفع
# Options: sandbox | moyasar | stripe | tap | paymob | hyperpay
# ══════════════════════════════════════════════════
PAYMENT_MODE=sandbox

# Moyasar
MOYASAR_API_KEY=your_moyasar_api_key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Tap Payments
TAP_SECRET_KEY=sk_test_your_tap_key

# Paymob
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id

# HyperPay
HYPERPAY_ACCESS_TOKEN=your_hyperpay_token
HYPERPAY_ENTITY_ID=your_entity_id

# ══════════════════════════════════════════════════
# Firebase Cloud Messaging
# ══════════════════════════════════════════════════
FCM_SERVER_KEY=your_firebase_server_key
FIREBASE_PROJECT_ID=sagya-haramain

# ══════════════════════════════════════════════════
# نسك Integration (Future)
# يحتاج موافقة رسمية من منصة نسك
# ══════════════════════════════════════════════════
NUSUK_PROVIDER=mock
NUSUK_API_URL=https://api.nusuk.sa/v1
NUSUK_API_KEY=

# ══════════════════════════════════════════════════
# Rate Limits
# ══════════════════════════════════════════════════
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
MAX_FILE_SIZE=5242880
